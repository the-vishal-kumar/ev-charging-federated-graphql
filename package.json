{
  "name": "ev-charging-federated-graphql",
  "version": "2.0.0",
  "private": true,
  "description": "EV charging stations from Open Charge Map, synced into MongoDB with change detection and served through an Apollo Federation 2 gateway with relay-style pagination.",
  "workspaces": [
    "src/gateway",
    "src/subgraphs/socket"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects e2e",
    "pretty": "prettier --write \"{src,test}/**/*.ts\"",
    "pretty:check": "prettier --check \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "generate:countries:json": "npm run generate:countries:json -w @ev-charging/socket-subgraph",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-vishal-kumar/ev-charging-federated-graphql.git"
  },
  "author": "Vishal Kumar <vishal194kumar@gmail.com>",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/the-vishal-kumar/ev-charging-federated-graphql/issues"
  },
  "homepage": "https://github.com/the-vishal-kumar/ev-charging-federated-graphql#readme",
  "engines": {
    "npm": ">=10",
    "node": ">=22"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@graphql-tools/utils": "^12.1.0"
  }
}
