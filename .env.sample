# Copied to .env by `make up`. Every value is optional; .env is git-ignored.

# Open Charge Map API key (https://openchargemap.org/site/develop/api).
# Empty: the socket subgraph starts and serves what is already stored, but does not sync.
OPEN_CHARGE_MAP_API_KEY=

# Sync schedule (cron, default daily at 00:01), whether to also sync at start-up,
# and which countries to sync (ISO 3166-1 alpha-2; supported: DE, IN).
SOCKET_SYNC_SCHEDULE=1 0 * * *
SOCKET_SYNC_ON_START=true
SOCKET_SYNC_COUNTRIES=DE,IN

# Host port for the gateway (http://localhost:4000).
GATEWAY_PORT=4000

# New Relic APM is loaded only when a licence key is set.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=ev-charging-federated-graphql
