{
  // Type-checks every service, test and fixture in one pass (npm run typecheck, ESLint, ts-jest).
  // Each service compiles itself with its own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "**/build"]
}
